{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesm.local/schemas/event_registry.schema.json",
  "title": "MESM independent event registry",
  "type": "object",
  "required": ["event_id", "municipality_id", "start_date", "event_type", "label_type", "label_source", "label_confidence", "data_status"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "municipality_id": {"type": "string", "minLength": 1},
    "start_date": {"type": "string", "format": "date"},
    "end_date": {"type": ["string", "null"], "format": "date"},
    "event_type": {"type": "string", "enum": ["demand", "income", "price", "fuel", "transport", "fiscal", "labor", "mixed", "other"]},
    "severity": {"type": ["number", "null"], "minimum": 0},
    "label_type": {"type": "string", "enum": ["external_event", "realized_outcome", "fiscal_confirmation"]},
    "label_source": {"type": "string", "minLength": 1},
    "label_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evaluation_eligible": {"type": "boolean", "default": false},
    "circularity_note": {"type": ["string", "null"]},
    "publication_date": {"type": ["string", "null"], "format": "date"},
    "source_ref": {"type": ["string", "null"]},
    "data_status": {"type": "string", "enum": ["official_public", "external_public", "synthetic", "manual_review"]}
  },
  "additionalProperties": false
}
