{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MESM Official Budget Plan",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "year", "municipality_name", "stage", "total_revenue",
      "revenue_base", "transfers", "expenditure", "deficit",
      "financing_sources", "source_url", "publication_date"
    ],
    "properties": {
      "year": {"type": "integer"},
      "municipality_name": {"type": "string"},
      "stage": {"type": "string"},
      "total_revenue": {"type": "number", "minimum": 0},
      "revenue_base": {"type": "number", "minimum": 0},
      "transfers": {"type": "number", "minimum": 0},
      "expenditure": {"type": "number", "minimum": 0},
      "deficit": {"type": "number", "minimum": 0},
      "financing_sources": {"type": "number", "minimum": 0},
      "debt_upper_limit": {"type": ["number", "null"], "minimum": 0},
      "debt_service": {"type": ["number", "null"], "minimum": 0},
      "exceptions_status": {"type": ["string", "null"]},
      "source_document": {"type": ["string", "null"]},
      "source_url": {"type": "string"},
      "publication_date": {"type": "string"},
      "notes": {"type": ["string", "null"]}
    }
  }
}
